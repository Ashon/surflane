{
  "name": "@surflane/ui",
  "version": "0.1.0",
  "description": "Surflane React components built on Base UI, with data, chart, code and Markdown components.",
  "keywords": [
    "design-system",
    "react",
    "components",
    "base-ui",
    "accessibility",
    "react-server-components",
    "surflane"
  ],
  "homepage": "https://surflane.page",
  "bugs": {
    "url": "https://github.com/Ashon/surflane/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ashon/surflane.git",
    "directory": "packages/ui"
  },
  "license": "MIT OR Apache-2.0",
  "author": "ashon",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "src/styles.css",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./src/styles.css",
    "./button": {
      "types": "./dist/button.d.ts",
      "import": "./dist/button.js"
    },
    "./slot": {
      "types": "./dist/slot.d.ts",
      "import": "./dist/slot.js"
    },
    "./input": {
      "types": "./dist/input.d.ts",
      "import": "./dist/input.js"
    },
    "./select": {
      "types": "./dist/select.d.ts",
      "import": "./dist/select.js"
    },
    "./popover": {
      "types": "./dist/popover.d.ts",
      "import": "./dist/popover.js"
    },
    "./tooltip": {
      "types": "./dist/tooltip.d.ts",
      "import": "./dist/tooltip.js"
    },
    "./dialog": {
      "types": "./dist/dialog.d.ts",
      "import": "./dist/dialog.js"
    },
    "./sizing": {
      "types": "./dist/sizing.d.ts",
      "import": "./dist/sizing.js"
    },
    "./chart": {
      "types": "./dist/chart.d.ts",
      "import": "./dist/chart.js"
    },
    "./markdown": {
      "types": "./dist/markdown.d.ts",
      "import": "./dist/markdown.js"
    },
    "./syntax-highlighter": {
      "types": "./dist/syntax-highlighter.d.ts",
      "import": "./dist/syntax-highlighter.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@headless-tree/core": "1.8.0",
    "@headless-tree/react": "1.8.0",
    "@internationalized/date": "3.12.4",
    "@tanstack/react-virtual": "3.14.21",
    "react-aria-components": "1.22.1",
    "react-markdown": "10.1.0",
    "recharts": "3.10.1",
    "remark-gfm": "4.0.1",
    "shiki": "4.5.0"
  },
  "peerDependencies": {
    "@surflane/design-tokens": "^0.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
